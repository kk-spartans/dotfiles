[tools]

# ──────────────
# System / standalone (no explicit backend)
# ──────────────
age = "latest"
bat = "latest"
bun = "latest"
delta = "latest"
deno = "latest"
eza = "latest"
fastfetch = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
gitleaks = "latest"
glow = "latest"
go = "latest"
hyperfine = "latest"
jq = "latest"
lazydocker = "latest"
lazygit = "latest"
neovim = "latest"
opencode = "latest"
pandoc = "latest"
pnpm = "latest"
ripgrep = "latest"
sccache = "latest"
uv = "latest"
zoxide = "latest"
"github:endevco/aube" = "latest"

# ──────────────
# GitHub
# ──────────────
"github:aria2/aria2" = "latest"
"github:babarot/gomi" = "latest"
"github:GitOxideLabs/gitoxide" = "latest"
"github:sharkdp/diskus" = "latest"
"github:sharkdp/hexyl" = "latest"
"github:simulot/immich-go" = "latest"
"github:rclone/rclone" = "latest"

# ──────────────
# npm (bun backend)
# ──────────────
"npm:fkill-cli" = "latest"
"npm:tokscale" = "latest"

# ──────────────
# pipx (uvx backend)
# ──────────────
"pipx:ansi2html" = "latest"
"pipx:copyparty" = "latest"
"pipx:img2pdf" = "latest"
"pipx:llm-markdownify" = "latest"
"pipx:magic-wormhole" = "latest"
"pipx:markitdown" = { version = "latest", uvx_args = "--python 3.12 --with python-pptx --with mammoth~=1.11.0 --with pandas --with openpyxl --with xlrd --with lxml --with pdfminer.six>=20251230 --with pdfplumber>=0.11.9 --with olefile --with pydub --with SpeechRecognition --with youtube-transcript-api~=1.0.0 --with azure-ai-documentintelligence --with azure-identity" }
"pipx:mitmproxy" = "latest"
"pipx:pygments" = "latest"
"pipx:spotdl" = "latest"
"pipx:tldr" = "latest"
"pipx:thefuck" = { version = "latest", uvx_args = "--python 3.11" }
"pipx:yt-dlp" = "latest"

{{- if eq .chezmoi.os "linux" }}

# ──────────────
# Linux-only
# ──────────────

## standalone
aws-cli = "latest"
node = "24"

{{- end }}

{{- if eq .chezmoi.os "windows" }}

# ──────────────
# Windows-only
# ──────────────

## standalone
oh-my-posh = "latest"
rust = "latest"
vercel = "latest"
node = "latest"

## GitHub
"github:axiomhq/cli" = "latest"
"github:BetterDiscord/cli" = "latest"
"github:Graphixa/FontGet" = "latest"
"github:mpv-player/mpv" = "latest"
"github:resend/resend-cli" = "latest"
"github:spicetify/cli" = "latest"
"github:ar51an/iperf3-win-builds" = "latest"
"github:voidtools/ES" = "latest"
"github:AlDanial/cloc" = { version = "latest", asset_pattern = "cloc-*.exe", bin = "cloc.exe" }

## activitywatch

"github:0xbrayo/aw-watcher-lastfm" = "latest"
"github:Alwinator/aw-watcher-utilization" = "latest"

## npm
"npm:agent-browser" = "latest"
"npm:fast-cli" = "latest"
"npm:workos" = "latest"
"npm:convex" = "latest"

## pipx
"pipx:ocrmypdf" = { version = "latest", uvx_args = "--with git+https://github.com/ocrmypdf/OCRmyPDF-EasyOCR.git --python 3.12 --index https://download.pytorch.org/whl/cu130" }
"pipx:aw-watcher-netstatus" = "latest"

## http
"http:ffmpeg" = { version = "latest", url = "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-full.7z", bin = "ffmpeg.exe", extract = true }

{{- end }}

[settings]
pipx.uvx = true
npm.package_manager = "bun"
cargo.binstall = true
