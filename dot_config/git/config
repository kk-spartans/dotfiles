[include]
    path = ~/.config/catppuccin.gitconfig
[user]
	name = Karthikeyan KK
	email = kcube.jan+github@gmail.com
	signingkey = 7FFC07EF617D1A01
[core]
	autocrlf = input
	eol = lf
	editor = code --wait
	longpaths = true
	pager = delta
[receive]
	denyNonFastForwards = true
[push]
	autoSetupRemote = true
[diff]
    colorMoved = default
[delta]
    line-numbers = true
	navigate = true
    features = catppuccin-mocha
    side-by-side = true
    hyperlinks = true
[init]
    defaultbranch = main
    templateDir = ~/.config/git/template
[interactive]
	diffFilter = delta --color-only
[merge]
    tool = vscode
	conflictStyle = zdiff3
[mergetool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[pull]
    rebase = true
[rebase]
    autoStash = true
[status]
    branch = true
    showStash = true
    showUntrackedFiles = normal
    submoduleSummary = true
