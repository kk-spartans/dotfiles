{{- if eq .chezmoi.os "linux" }}
#!/bin/bash
set -e

email="kcube.jan+github@gmail.com"
name="Karthikeyan KK"
preferred_key="7FFC07EF617D1A01"
user_gpg_home="$HOME/.gnupg"

# Ensure gpg is installed
command -v gpg >/dev/null 2>&1 || { echo "gpg not found"; exit 1; }

# Create GPG home if it doesn't exist
mkdir -p "$user_gpg_home"

# Start gpg-agent
gpgconf --homedir "$user_gpg_home" --launch gpg-agent >/dev/null 2>&1 || true

# Check if preferred key exists
user_key=$(gpg --homedir "$user_gpg_home" --list-secret-keys --with-colons --keyid-format LONG "$preferred_key" 2>/dev/null | grep "^sec" | head -n1)

if [[ -z "$user_key" ]]; then
    # Check if any key for email exists
    any_user_key=$(gpg --homedir "$user_gpg_home" --list-secret-keys --with-colons --keyid-format LONG "$email" 2>/dev/null | grep "^sec" | head -n1)
    
    if [[ -n "$any_user_key" ]]; then
        gpg --homedir "$user_gpg_home" --list-secret-keys --keyid-format LONG "$email"
        exit 0
    fi

    # Generate a new key if none found
    tmpfile=$(mktemp)
    cat > "$tmpfile" <<EOF
Key-Type: eddsa
Key-Curve: ed25519
Subkey-Type: eddsa
Subkey-Curve: ed25519
Name-Real: $name
Name-Email: $email
Expire-Date: 0
%no-protection
%commit
EOF

    gpg --homedir "$user_gpg_home" --batch --generate-key "$tmpfile"
    rm -f "$tmpfile"
fi

# List the secret key at the end
gpg --homedir "$user_gpg_home" --list-secret-keys --keyid-format LONG "$preferred_key"
{{- end }}
