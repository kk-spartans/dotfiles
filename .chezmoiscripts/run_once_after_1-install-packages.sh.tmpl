{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -e

echo "iperf3 iperf3/start_daemon boolean true" | sudo debconf-set-selections
sudo apt-get install -y p7zip-full fish iperf3 ncdu ffmpeg btop tmux speedtest-cli cec-utils mpv

if ! command -v docker >/dev/null 2>&1; then
  curl -fsSL https://get.docker.com | sh
fi

FISH_SHELL="$(command -v fish)"

CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$CURRENT_SHELL" != "$FISH_SHELL" ]; then
  sudo usermod -s "$FISH_SHELL" "$USER"
fi
if ! command -v tailscale >/dev/null 2>&1; then
  curl -fsSL https://tailscale.com/install.sh | sh
  sudo tailscale set --operator=$USER
fi

if ! command -v ollama >/dev/null 2>&1; then
  curl -fsSL https://ollama.com/install.sh | sh
fi

if ! command -v brew >/dev/null 2>&1; then
  NONINTERACTIVE=1 CI=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if ! command -v mise >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
  curl https://mise.run | sh
fi


~/.local/bin/mise install
eval "$(~/.local/bin/mise activate bash --shims)"

pnpm setup

cd "$HOME"
eval "$("$MISE_BIN" activate bash)"
cp ".agents/.skill-lock.json" "skills-lock.json"
bun x skills experimental_install
rm -f "skills-lock.json"
{{- end }}
