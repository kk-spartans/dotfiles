{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -e

sudo apt-get install -y p7zip-full fish iperf3 ncdu ffmpeg btop tmux speedtest-cli

if ! command -v docker >/dev/null 2>&1; then
  curl -fsSL https://get.docker.com | sh
fi

FISH_SHELL="$(command -v fish)"

CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [ "$CURRENT_SHELL" != "$FISH_SHELL" ]; then
  echo "input password for chsh"
  chsh -s "$FISH_SHELL"
fi
if ! command -v tailscale >/dev/null 2>&1; then
  curl -fsSL https://tailscale.com/install.sh | sh
fi

if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if ! command -v mise >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
  curl https://mise.run | sh
fi

MISE_BIN="$(command -v mise || true)"
if [ -z "$MISE_BIN" ]; then
  MISE_BIN="$HOME/.local/bin/mise"
fi

"$MISE_BIN" install

pnpm setup

cd "$HOME"
eval "$("$MISE_BIN" activate bash)"
cp ".agents/.skill-lock.json" "skills-lock.json"
bun x skills experimental_install
rm -f "skills-lock.json"
{{- end }}
